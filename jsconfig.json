{
  // 繁體中文註解：配置 TypeScript 編譯選項，用於驗證 JavaScript 程式碼
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.ts",
    "server.js",
    "tests/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dashboard"
  ]
}
