PORT=3011
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3011/callback/spotify
GEMINI_API_KEY=

# 掃描週期天數：在此天數內將所有關注藝人完整掃描一輪（每天執行8次，預設為7天）
SCAN_CYCLE_DAYS=7

# 社群自動發文微服務 URL（social-post-service）
SOCIAL_SERVICE_URL=http://localhost:3012

# === 歌詞翻譯 provider 與快取 ===
# provider：gemini（預設，需 GEMINI_API_KEY）或 ollama（本地模型，零 API 費用）
LYRICS_PROVIDER=gemini
# 快取目錄（Obsidian 相容 Markdown）。預設 data/lyrics-cache/；
# 指到你的 Obsidian vault 即可把翻譯收進筆記庫，例如：
# LYRICS_CACHE_DIR=/Users/you/Obsidian/MusicNotes/lyrics
# Ollama 設定（LYRICS_PROVIDER=ollama 時生效）
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OG 分享端點導向的前端 URL
DASHBOARD_URL=http://localhost:5173
