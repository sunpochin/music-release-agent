PORT=3011
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3011/callback/spotify
GEMINI_API_KEY=

# 掃描週期天數：在此天數內將所有關注藝人完整掃描一輪（每天執行8次，預設為7天）
SCAN_CYCLE_DAYS=7

# 社群自動發文微服務 URL（social-post-service）
SOCIAL_SERVICE_URL=http://localhost:3012

# 歌詞翻譯微服務 URL（lyrics-vault-service）
# 翻譯 provider、Obsidian vault 路徑等設定在該 repo 的 .env，不在這裡
LYRICS_SERVICE_URL=http://localhost:3013

# OG 分享端點導向的前端 URL
DASHBOARD_URL=http://localhost:5173
