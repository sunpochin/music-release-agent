{
  "name": "music-release-agent",
  "version": "1.0.0",
  "description": "Spotify release scanner, AI review generator, and GitBook publisher",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "scan": "node scan-releases.js",
    "scan:dry": "node scan-releases-dry.js",
    "demo:verify": "node scripts/demo-verify.js",
    "demo:verify:social": "node scripts/demo-verify-social-handoff.js",
    "demo:verify:social:down": "node scripts/demo-verify-social-down.js",
    "test": "vitest run",
    "test:golden": "vitest run tests/golden",
    "test:coverage": "vitest run --coverage && node generate-badge.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@google/genai": "^2.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "http-proxy-middleware": "^3.0.6",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "undici": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^3.2.6",
    "vitest": "^3.2.6"
  }
}
